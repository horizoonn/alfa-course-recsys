# Адрес Go API. В dev-режиме /api проксируется vite-ом на localhost:8080,
# поэтому переменную можно не задавать. Для продакшена указать публичный HTTPS URL.
# VITE_API_BASE=https://your-backend.example.com/api

# true — фронт работает без бэкенда на мок-данных (удобно до восстановления БД).
# false — реальные запросы к Go API.
VITE_USE_MOCK=true
