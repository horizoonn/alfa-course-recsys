# Токен бота из BotFather: /mybots -> выбрать бота -> API Token.
# НИКОГДА не коммитьте реальный токен: .env уже в .gitignore.
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Публичный HTTPS-адрес Mini App (frontend).
# Вариант 1 (проще): деплой frontend/dist на https://app.netlify.com/drop -> https://xxxx.netlify.app
# Вариант 2: туннель к локальному серверу, например cloudflared tunnel --url http://localhost:4173
# localhost и http:// Telegram не принимает — кнопка не появится.
WEBAPP_URL=https://your-app.netlify.app

# Текст кнопки запуска (inline и кнопки меню)
BOT_MENU_TEXT=Открыть Альфа Курс
